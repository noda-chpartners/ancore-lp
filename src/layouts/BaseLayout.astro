---
import '../styles/reset.css';
import '../styles/global.css';
import { siteContent } from '../contents/content';

interface Props {
  title: string;
  description: string;
  ogImage: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://ancore.pages.dev');
const ogImageUrl = new URL(ogImage, canonicalUrl);
const logoUrl = new URL('/favicon.png', canonicalUrl).href;
const { ogImageAlt, ogImageWidth, ogImageHeight } = siteContent.site;
const instagramUrl = siteContent.entry.instagram.href.split('?')[0];
const siteUrl = canonicalUrl.href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: siteContent.company.name,
      url: siteUrl,
      logo: logoUrl,
      telephone: '080-4854-5503',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '中丸町26-1',
        addressLocality: '板橋区',
        addressRegion: '東京都',
        addressCountry: 'JP',
      },
      openingHours: 'Mo-Su 09:00-20:00',
      sameAs: [instagramUrl],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: '株式会社Ancore 採用サイト',
      url: siteUrl,
      description,
      inLanguage: 'ja',
      publisher: {
        '@id': `${siteUrl}#organization`,
      },
    },
  ],
};
---

<!doctype html>
<html class="site-root" lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fffdf7" />
    <meta name="google-site-verification" content="W6X3cwCqNwAUejsnK3WonJ1538dIruj4tj0PKa2gu5U" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={siteContent.company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="site-body">
    <slot />
  </body>
</html>

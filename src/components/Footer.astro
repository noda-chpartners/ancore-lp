---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  content: {
    logo: {
      src: ImageMetadata;
      alt: string;
    };
    instagram: string;
    copyright: string;
  };
}

const { content } = Astro.props;
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <a class="footer__logo-link" href="#top" aria-label="ページ上部へ戻る">
        <Image
          class="footer__logo"
          src={content.logo.src}
          alt={content.logo.alt}
          width={156}
          quality={90}
        />
      </a>

      <p class="footer__statement">
        <span class="footer__statement-line">もう一度、</span>
        <span class="footer__statement-line">本気になれる瞬間を創る。</span>
      </p>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {content.copyright}</p>
      <a
        class="footer__social"
        href={content.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="AncoreのInstagramを見る"
      >
        <Icon class="footer__social-icon" name="simple-icons:instagram" />
        <span class="footer__social-label">Instagram</span>
      </a>
      <a class="footer__back" href="#top">
        <span class="footer__back-label">BACK TO TOP</span>
        <span class="footer__back-arrow" aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style lang="scss">
  .footer {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 1.5rem;
    background:
      radial-gradient(circle at 90% 0%, rgba(142, 216, 230, 0.18), transparent 34%),
      var(--color-cream);

    &__top {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      padding-bottom: clamp(3rem, 7vw, 5rem);
      border-bottom: 1px solid rgba(32, 50, 56, 0.15);
    }

    &__logo-link {
      display: block;
      width: clamp(7rem, 10vw, 9.75rem);
    }

    &__logo {
      width: 100%;
      height: auto;
    }

    &__statement {
      color: rgba(32, 50, 56, 0.76);
      font-size: clamp(1rem, 2vw, 1.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.4;
      text-align: right;
    }

    &__statement-line {
      display: block;
      white-space: nowrap;
    }

    &__bottom {
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: clamp(1rem, 3vw, 2.5rem);
      padding-top: 1.5rem;
      color: rgba(32, 50, 56, 0.58);
      font-family: var(--font-display);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.12em;
    }

    &__social,
    &__back {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      transition: color 0.25s ease;

      &:hover {
        color: var(--color-gold);
      }
    }

    &__social-icon {
      width: 1rem;
      height: 1rem;
    }

    &__back-arrow {
      display: grid;
      width: 2.25rem;
      height: 2.25rem;
      place-items: center;
      border: 1px solid rgba(63, 159, 179, 0.3);
      border-radius: 50%;
      font-size: 1rem;
    }
  }

  @media (max-width: 600px) {
    .footer {
      &__top {
        align-items: flex-start;
        flex-direction: column;
      }

      &__statement {
        text-align: left;
      }

      &__bottom {
        grid-template-columns: 1fr auto;
      }

      &__copyright {
        grid-column: 1 / -1;
        grid-row: 2;
      }
    }
  }
</style>

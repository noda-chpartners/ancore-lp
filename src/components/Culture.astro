---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  content: {
    images: readonly {
      src: ImageMetadata;
      alt: string;
    }[];
  };
}

const { content } = Astro.props;
---

<section class="culture section" id="culture">
  <div class="culture__heading container">
    <div class="section-heading js-reveal">
      <p class="eyebrow">LIFE AT ANCORE</p>
      <h2 class="section-title">
        <span class="title-line">本気のそばには、</span>
        <span class="title-line">いつも仲間がいる。</span>
      </h2>
      <p class="section-lead">
        挑戦する時間も、笑い合う時間も。写真で見るAncoreの日常。
      </p>
    </div>
  </div>

  <div class="culture__gallery" data-gallery>
    {
      content.images.map((image, index) => (
        <figure class:list={['culture__item', `culture__item--${index + 1}`, 'js-gallery-item']}>
          <Image
            class="culture__image"
            src={image.src}
            alt={image.alt}
            loading="lazy"
            quality={84}
            widths={[420, 640, 960]}
            sizes="(max-width: 767px) 72vw, 34vw"
          />
          <span class="culture__index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
        </figure>
      ))
    }
  </div>
</section>

<style lang="scss">
  .culture {
    padding-bottom: calc(var(--section-space) + 2rem);
    background:
      radial-gradient(circle at 12% 10%, rgba(255, 148, 24, 0.16), transparent 28%),
      var(--color-night);

    &__gallery {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: 3.8vw;
      gap: 1rem;
      width: min(calc(100% - 2rem), 1440px);
      margin-inline: auto;
    }

    &__item {
      position: relative;
      overflow: hidden;
      margin: 0;
      background: var(--color-night-soft);

      &::after {
        position: absolute;
        inset: 0;
        border: 1px solid rgba(255, 248, 233, 0.12);
        content: "";
        pointer-events: none;
      }

      &--1 {
        grid-area: 1 / 1 / span 7 / span 4;
      }

      &--2 {
        grid-area: 2 / 5 / span 6 / span 5;
      }

      &--3 {
        grid-area: 1 / 10 / span 8 / span 3;
      }

      &--4 {
        grid-area: 8 / 1 / span 6 / span 5;
      }

      &--5 {
        grid-area: 8 / 6 / span 8 / span 3;
      }

      &--6 {
        grid-area: 9 / 9 / span 6 / span 4;
      }

      &--7 {
        grid-area: 14 / 1 / span 5 / span 4;
      }

      &--8 {
        grid-area: 16 / 5 / span 5 / span 5;
      }
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition:
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        filter 0.5s ease;
    }

    &__item:hover &__image {
      filter: saturate(1.15);
      transform: scale(1.045);
    }

    &__index {
      position: absolute;
      z-index: 1;
      right: 0.8rem;
      bottom: 0.55rem;
      display: grid;
      width: 2rem;
      height: 2rem;
      place-items: center;
      border-radius: 50%;
      color: var(--color-night);
      background: var(--color-gold);
      font-family: var(--font-display);
      font-size: 0.55rem;
      font-weight: 900;
    }
  }

  @media (max-width: 767px) {
    .culture {
      &__gallery {
        display: flex;
        width: 100%;
        gap: 0.8rem;
        overflow-x: auto;
        padding: 0 1rem 1.5rem;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
      }

      &__gallery::-webkit-scrollbar {
        display: none;
      }

      &__item {
        width: min(76vw, 22rem);
        flex: 0 0 auto;
        aspect-ratio: 4 / 5;
        scroll-snap-align: center;
      }
    }
  }
</style>

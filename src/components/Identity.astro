---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  content: {
    mission: {
      label: string;
      titleLines: readonly string[];
      subtitleLines: readonly string[];
      descriptionBlocks: readonly (readonly string[])[];
    };
    vision: {
      label: string;
      title: string;
      subtitleLines: readonly string[];
      descriptionLines: readonly string[];
    };
    philosophy: {
      label: string;
      title: string;
      subtitleLines: readonly string[];
      conclusion: string;
      image: ImageMetadata;
      imageAlt: string;
    };
  };
}

const { content } = Astro.props;
---

<section class="identity section" id="about">
  <div class="identity__marquee" aria-hidden="true">
    <span class="identity__marquee-track">
      ONCE MORE, WITH EVERYTHING. ONCE MORE, WITH EVERYTHING.
    </span>
  </div>

  <div class="identity__inner container">
    <div class="identity__intro">
      <p class="eyebrow js-reveal">WHO WE ARE</p>
      <div class="identity__statements">
        <article class="identity__statement js-reveal">
          <p class="identity__label">{content.mission.label}</p>
          <h2 class="identity__headline">
            {
              content.mission.titleLines.map((line) => (
                <span class="title-line">{line}</span>
              ))
            }
          </h2>
          <div class="identity__mission-copy">
            <p class="identity__mission-subtitle">
              {
                content.mission.subtitleLines.map((line) => (
                  <span class="identity__mission-line">{line}</span>
                ))
              }
            </p>
            {
              content.mission.descriptionBlocks.map((block) => (
                <p class="identity__mission-description">
                  {block.map((line) => (
                    <span class="identity__mission-line">{line}</span>
                  ))}
                </p>
              ))
            }
          </div>
        </article>
        <article class="identity__statement identity__statement--vision js-reveal">
          <p class="identity__label">{content.vision.label}</p>
          <div class="identity__vision-body">
            <p class="identity__vision">{content.vision.title}</p>
            <p class="identity__vision-subtitle">
              {
                content.vision.subtitleLines.map((line) => (
                  <span class="identity__vision-line">{line}</span>
                ))
              }
            </p>
            <p class="identity__vision-description">
              {
                content.vision.descriptionLines.map((line) => (
                  <span class="identity__vision-line">{line}</span>
                ))
              }
            </p>
          </div>
        </article>
      </div>
    </div>

    <div class="identity__philosophy">
      <div class="identity__photo-wrap js-reveal">
        <div class="identity__photo-frame" data-parallax-image>
          <Image
            class="identity__photo"
            src={content.philosophy.image}
            alt={content.philosophy.imageAlt}
            quality={86}
            widths={[480, 720, 960]}
            sizes="(max-width: 767px) 100vw, 48vw"
          />
        </div>
        <p class="identity__photo-caption">ANCORE / TOKYO</p>
      </div>

      <div class="identity__copy js-reveal">
        <p class="identity__label">{content.philosophy.label}</p>
        <h3 class="identity__copy-title">{content.philosophy.title}</h3>
        <p class="identity__copy-subtitle">
          {
            content.philosophy.subtitleLines.map((line) => (
              <span class="identity__copy-subtitle-line">{line}</span>
            ))
          }
        </p>
        <p class="identity__conclusion">{content.philosophy.conclusion}</p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .identity {
    color: var(--color-ink);
    background:
      radial-gradient(circle at 88% 8%, rgba(213, 170, 79, 0.22), transparent 22%),
      var(--color-ivory);

    &__marquee {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      overflow: hidden;
      color: rgba(63, 159, 179, 0.1);
      font-family: var(--font-display);
      font-size: clamp(3.2rem, 9vw, 8rem);
      font-weight: 900;
      letter-spacing: -0.06em;
      line-height: 1;
      white-space: nowrap;
      pointer-events: none;
    }

    &__marquee-track {
      display: block;
      width: max-content;
      animation: marquee 28s linear infinite;
    }

    &__inner {
      position: relative;
      z-index: 1;
    }

    &__intro {
      display: grid;
      grid-template-columns: 0.34fr 1fr;
      gap: clamp(2rem, 6vw, 7rem);
      padding-bottom: clamp(5rem, 10vw, 9rem);

      :global(.eyebrow) {
        color: var(--color-aqua-deep);
      }
    }

    &__statements {
      display: grid;
      gap: 4rem;
    }

    &__statement {
      max-width: 55rem;
    }

    &__statement--vision {
      display: grid;
      grid-template-columns: 7rem 1fr;
      align-items: start;
      gap: 1rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(7, 10, 14, 0.18);
    }

    &__label {
      color: var(--color-aqua-deep);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    &__headline {
      margin-top: 1.15rem;
      font-family: var(--font-display);
      font-size: clamp(2.15rem, 4.6vw, 4.3rem);
      font-weight: 900;
      letter-spacing: -0.075em;
      line-height: 1.05;
    }

    &__mission-copy {
      display: grid;
      gap: 1.15rem;
      max-width: 38rem;
      margin-top: 1.75rem;
    }

    &__mission-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.45rem);
      font-weight: 800;
      letter-spacing: 0.02em;
      line-height: 1.7;
    }

    &__mission-description {
      color: rgba(7, 10, 14, 0.72);
      font-size: clamp(0.88rem, 1.2vw, 1rem);
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 2;
    }

    &__mission-line {
      display: block;
    }

    &__vision {
      font-size: clamp(1.3rem, 2.7vw, 2.15rem);
      font-weight: 900;
      letter-spacing: -0.04em;
    }

    &__vision-body {
      display: grid;
      gap: 1.15rem;
    }

    &__vision-subtitle {
      font-size: clamp(1.05rem, 2vw, 1.45rem);
      font-weight: 800;
      letter-spacing: 0.02em;
      line-height: 1.7;
    }

    &__vision-description {
      color: rgba(7, 10, 14, 0.72);
      font-size: clamp(0.88rem, 1.2vw, 1rem);
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 2;
    }

    &__vision-line {
      display: block;
    }

    &__philosophy {
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.82fr);
      align-items: center;
      gap: clamp(2.5rem, 7vw, 8rem);
    }

    &__photo-wrap {
      position: relative;
      padding: 0 0 1.5rem 1.5rem;
    }

    &__photo-wrap::before {
      position: absolute;
      z-index: -1;
      bottom: 0;
      left: 0;
      width: 62%;
      height: 76%;
      background: linear-gradient(145deg, var(--color-gold), var(--color-aqua));
      content: "";
    }

    &__photo-frame {
      overflow: hidden;
      aspect-ratio: 4 / 3;
      background: var(--color-cream);
    }

    &__photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 36%;
      will-change: transform;
    }

    &__photo-caption {
      position: absolute;
      right: 1rem;
      bottom: 0.1rem;
      color: rgba(7, 10, 14, 0.62);
      font-family: var(--font-display);
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.24em;
    }

    &__copy-title {
      margin-top: 1.25rem;
      font-size: clamp(1.4rem, 2.6vw, 2.15rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.45;
    }

    &__copy-subtitle {
      margin-top: 1.5rem;
      font-size: clamp(0.95rem, 1.5vw, 1.15rem);
      font-weight: 800;
      letter-spacing: 0.03em;
      line-height: 1.9;
    }

    &__copy-subtitle-line {
      display: block;
    }

    &__conclusion {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(7, 10, 14, 0.16);
      color: rgba(7, 10, 14, 0.72);
      font-size: 0.9rem;
      line-height: 2.2;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 767px) {
    .identity {
      &__intro {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      &__statements {
        gap: 2.5rem;
      }

      &__statement--vision {
        grid-template-columns: 1fr;
        gap: 0.75rem;
      }

      &__headline {
        font-size: clamp(1.85rem, 8.4vw, 2.85rem);
      }

      &__philosophy {
        grid-template-columns: 1fr;
      }

      &__photo-wrap {
        padding: 0 0 1rem 1rem;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .identity {
      &__marquee-track {
        animation: none;
      }

      &__photo {
        will-change: auto;
      }
    }
  }
</style>

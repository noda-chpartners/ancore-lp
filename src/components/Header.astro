---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  content: {
    logo: {
      src: ImageMetadata;
      alt: string;
    };
    nav: readonly {
      label: string;
      href: string;
      isButton?: boolean;
    }[];
  };
}

const { content } = Astro.props;
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__logo-link" href="/" aria-label="株式会社Ancore トップへ">
      <Image
        class="header__logo-image"
        src={content.logo.src}
        alt={content.logo.alt}
        width={112}
        quality={90}
      />
    </a>

    <button
      class="header__menu-button"
      type="button"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="global-navigation"
      data-menu-toggle
    >
      <span class="header__menu-line"></span>
      <span class="header__menu-line"></span>
      <span class="header__menu-label">MENU</span>
    </button>

    <nav class="header__nav" id="global-navigation" aria-label="メインナビゲーション" data-menu>
      <ul class="header__nav-list">
        {
          content.nav.map((item, index) => (
            <li class="header__nav-item">
              <a
                class:list={[
                  'header__nav-link',
                  { 'header__nav-link--cta': item.isButton },
                ]}
                href={item.href}
              >
                <span class="header__nav-number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="header__nav-label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuLinks = menu?.querySelectorAll<HTMLAnchorElement>('a');

  const setMenuState = (isOpen: boolean) => {
    menuButton?.classList.toggle('is-open', isOpen);
    menu?.classList.toggle('is-open', isOpen);
    header?.classList.toggle('is-menu-open', isOpen);
    document.body.classList.toggle('is-menu-open', isOpen);
    menuButton?.setAttribute('aria-expanded', String(isOpen));
    menuButton?.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');
  };

  menuButton?.addEventListener('click', () => {
    setMenuState(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  menuLinks?.forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuState(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 960) setMenuState(false);
  });

  window.addEventListener(
    'scroll',
    () => header?.classList.toggle('is-scrolled', window.scrollY > 24),
    { passive: true },
  );
</script>

<style lang="scss">
  .header {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    padding: 1.15rem 0;
    transition:
      padding 0.35s ease,
      background-color 0.35s ease,
      backdrop-filter 0.35s ease;

    &.is-scrolled,
    &.is-menu-open {
      padding: 0.65rem 0;
    }

    /* backdrop-filter は fixed 子要素の包含ブロックを作るため、メニュー展開時は付けない */
    &.is-scrolled:not(.is-menu-open) {
      background: rgba(255, 253, 247, 0.9);
      border-bottom: 1px solid rgba(32, 50, 56, 0.08);
      box-shadow: 0 8px 30px rgba(63, 159, 179, 0.08);
      backdrop-filter: blur(18px);
    }

    &__inner {
      display: flex;
      width: min(calc(100% - 3rem), 1320px);
      align-items: center;
      justify-content: space-between;
      margin-inline: auto;
    }

    &__logo-link {
      position: relative;
      z-index: 2;
      display: block;
      width: clamp(4.6rem, 6.2vw, 6rem);
    }

    &__logo-image {
      display: block;
      width: 100%;
      height: auto;
      filter: drop-shadow(0 8px 20px rgba(63, 159, 179, 0.16));
    }

    &__nav-list {
      display: flex;
      align-items: center;
      gap: clamp(0.8rem, 1.6vw, 2rem);
    }

    &__nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: rgba(32, 50, 56, 0.82);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      transition: color 0.25s ease;

      &:hover {
        color: var(--color-gold);
      }

      &--cta {
        min-height: 2.8rem;
        padding: 0.65rem 1.15rem;
        border-radius: 999px;
        color: var(--color-ink);
        background: var(--gradient-brand);

        &:hover {
          color: var(--color-ink);
          background: var(--color-ivory);
        }
      }
    }

    &__nav-number {
      color: var(--color-aqua-deep);
      font-family: var(--font-display);
      font-size: 0.54rem;
      letter-spacing: 0.08em;
    }

    &__menu-button {
      position: relative;
      z-index: 2;
      display: none;
      width: 3.25rem;
      height: 3.25rem;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(63, 159, 179, 0.34);
      border-radius: 50%;
      color: var(--color-ink);
      background: rgba(255, 253, 247, 0.94);
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.6),
        0 10px 28px rgba(63, 159, 179, 0.18);
      backdrop-filter: blur(16px);
    }

    &__menu-line {
      position: absolute;
      left: 0.85rem;
      width: 1.55rem;
      height: 1px;
      background: currentColor;
      transition:
        transform 0.35s ease,
        top 0.35s ease;

      &:first-child {
        top: 1.15rem;
      }

      &:nth-child(2) {
        top: 1.55rem;
      }
    }

    &__menu-label {
      position: absolute;
      bottom: 0.35rem;
      font-size: 0.43rem;
      font-weight: 800;
      letter-spacing: 0.12em;
    }
  }

  @media (max-width: 960px) {
    .header {
      &__inner {
        width: min(calc(100% - 2rem), 1320px);
      }

      &__menu-button {
        display: flex;

        &.is-open {
          .header__menu-line {
            top: 1.35rem;
          }

          .header__menu-line:first-child {
            transform: rotate(45deg);
          }

          .header__menu-line:nth-child(2) {
            transform: rotate(-45deg);
          }
        }
      }

      &__nav {
        position: fixed;
        inset: 0;
        z-index: 1;
        display: grid;
        visibility: hidden;
        width: 100vw;
        height: 100dvh;
        place-items: center;
        padding: 6.5rem 2rem 3rem;
        opacity: 0;
        background:
          radial-gradient(circle at 80% 10%, rgba(142, 216, 230, 0.3), transparent 36%),
          radial-gradient(circle at 10% 80%, rgba(213, 170, 79, 0.16), transparent 34%),
          var(--color-ivory);
        transform: translateY(-1rem);
        transition:
          opacity 0.35s ease,
          visibility 0.35s ease,
          transform 0.35s ease;

        &.is-open {
          visibility: visible;
          opacity: 1;
          transform: translateY(0);
        }
      }

      &__nav-list {
        display: grid;
        width: min(100%, 28rem);
        gap: 0;
      }

      &__nav-item {
        border-bottom: 1px solid rgba(32, 50, 56, 0.13);
      }

      &__nav-link {
        display: grid;
        grid-template-columns: 2.2rem 1fr;
        gap: 0.8rem;
        padding: 1.1rem 0;
        font-size: clamp(1rem, 4vw, 1.35rem);

        &--cta {
          display: flex;
          margin-top: 1.5rem;
          justify-content: center;
          padding: 1rem 1.5rem;
        }
      }

      &__nav-number {
        font-size: 0.62rem;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: none;

      &__nav,
      &__menu-line {
        transition: none;
      }
    }
  }
</style>

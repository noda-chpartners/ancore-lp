<div class="three-stage" data-three-stage aria-hidden="true"></div>

<script>
  import * as THREE from 'three';

  const mount = document.querySelector<HTMLElement>('[data-three-stage]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (mount) {
    const isMobile = window.innerWidth < 768;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    const stageGroup = new THREE.Group();
    const pieceCount = isMobile ? 56 : 118;
    const sparkleCount = isMobile ? 90 : 190;
    const confettiGeometry = new THREE.PlaneGeometry(0.1, 0.24);
    const dummy = new THREE.Object3D();
    const colors = [
      new THREE.Color('#c79334'),
      new THREE.Color('#e3bd5d'),
      new THREE.Color('#3f9fb3'),
      new THREE.Color('#8ed8e6'),
    ];
    const piecesPerColor = Math.ceil(pieceCount / colors.length);
    const confettiMaterials = colors.map(
      (color) =>
        new THREE.MeshBasicMaterial({
          color,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.94,
          depthWrite: false,
          toneMapped: false,
        }),
    );
    const confettiMeshes = confettiMaterials.map(
      (material) =>
        new THREE.InstancedMesh(
          confettiGeometry,
          material,
          piecesPerColor,
        ),
    );
    const pieces = Array.from({ length: pieceCount }, (_, index) => {
      return {
        x: (Math.random() - 0.5) * 8.5,
        y: (Math.random() - 0.5) * 6.5,
        z: (Math.random() - 0.5) * 4,
        speed: 0.002 + Math.random() * 0.004,
        spin: (Math.random() - 0.5) * 0.02,
        phase: Math.random() * Math.PI * 2,
        meshIndex: index % colors.length,
        instanceIndex: Math.floor(index / colors.length),
      };
    });
    const sparklePositions = new Float32Array(sparkleCount * 3);
    const sparkleColors = new Float32Array(sparkleCount * 3);

    for (let index = 0; index < sparkleCount; index += 1) {
      const offset = index * 3;
      const color = colors[index % colors.length];
      sparklePositions[offset] = (Math.random() - 0.5) * 9.5;
      sparklePositions[offset + 1] = (Math.random() - 0.5) * 6;
      sparklePositions[offset + 2] = (Math.random() - 0.5) * 3 - 0.4;
      sparkleColors[offset] = color.r;
      sparkleColors[offset + 1] = color.g;
      sparkleColors[offset + 2] = color.b;
    }

    const sparkleGeometry = new THREE.BufferGeometry();
    sparkleGeometry.setAttribute(
      'position',
      new THREE.BufferAttribute(sparklePositions, 3),
    );
    sparkleGeometry.setAttribute(
      'color',
      new THREE.BufferAttribute(sparkleColors, 3),
    );
    const sparkleMaterial = new THREE.PointsMaterial({
      size: isMobile ? 0.035 : 0.045,
      transparent: true,
      opacity: 0.85,
      vertexColors: true,
      depthWrite: false,
      blending: THREE.NormalBlending,
      toneMapped: false,
    });
    const sparkles = new THREE.Points(sparkleGeometry, sparkleMaterial);

    const ringMaterial = new THREE.MeshBasicMaterial({
      color: '#d5aa4f',
      transparent: true,
      opacity: 0.3,
      depthWrite: false,
      blending: THREE.NormalBlending,
      toneMapped: false,
    });
    const ringSmallMaterial = ringMaterial.clone();
    ringSmallMaterial.color.set('#8ed8e6');
    const ringGeometryLarge = new THREE.TorusGeometry(2.1, 0.008, 8, 120);
    const ringGeometrySmall = new THREE.TorusGeometry(1.45, 0.006, 8, 100);
    const ringLarge = new THREE.Mesh(ringGeometryLarge, ringMaterial);
    const ringSmall = new THREE.Mesh(ringGeometrySmall, ringSmallMaterial);

    ringLarge.position.set(isMobile ? 1.8 : 2.8, 0.4, -1.7);
    ringLarge.rotation.set(1.1, 0.35, -0.25);
    ringSmall.position.set(isMobile ? 1.65 : 2.55, 0.35, -1.3);
    ringSmall.rotation.set(0.85, -0.25, 0.42);

    stageGroup.add(...confettiMeshes, sparkles, ringLarge, ringSmall);
    scene.add(stageGroup);

    let frameId = 0;
    let pointerX = 0;
    let pointerY = 0;

    camera.position.z = 7;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.domElement.className = 'three-stage__canvas';
    mount.append(renderer.domElement);

    const resize = () => {
      const bounds = mount.getBoundingClientRect();
      camera.aspect = bounds.width / Math.max(bounds.height, 1);
      camera.updateProjectionMatrix();
      renderer.setSize(bounds.width, bounds.height, false);
    };

    const draw = (time = 0) => {
      pieces.forEach((piece) => {
        const progress = reduceMotion ? piece.phase : time * piece.speed + piece.phase;
        dummy.position.set(
          piece.x + Math.sin(progress * 0.7) * 0.22,
          ((piece.y - progress * 0.65 + 10) % 7) - 3.5,
          piece.z,
        );
        dummy.rotation.set(progress * 0.9, progress * 1.25, progress * piece.spin * 30);
        dummy.updateMatrix();
        confettiMeshes[piece.meshIndex].setMatrixAt(
          piece.instanceIndex,
          dummy.matrix,
        );
      });

      confettiMeshes.forEach((mesh) => {
        mesh.instanceMatrix.needsUpdate = true;
      });
      stageGroup.rotation.z = Math.sin(time * 0.00014) * 0.025;
      sparkles.rotation.y = time * 0.000025;
      ringLarge.rotation.z = time * 0.00008;
      ringSmall.rotation.z = -time * 0.00011;
      camera.position.x += (pointerX * 0.35 - camera.position.x) * 0.025;
      camera.position.y += (-pointerY * 0.2 - camera.position.y) * 0.025;
      renderer.render(scene, camera);
      if (!reduceMotion) frameId = requestAnimationFrame(draw);
    };

    const handlePointer = (event: PointerEvent) => {
      pointerX = (event.clientX / window.innerWidth - 0.5) * 2;
      pointerY = (event.clientY / window.innerHeight - 0.5) * 2;
    };

    resize();
    draw();
    window.addEventListener('resize', resize);
    window.addEventListener('pointermove', handlePointer, { passive: true });

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(frameId);
      window.removeEventListener('resize', resize);
      window.removeEventListener('pointermove', handlePointer);
      confettiGeometry.dispose();
      confettiMaterials.forEach((material) => material.dispose());
      sparkleGeometry.dispose();
      sparkleMaterial.dispose();
      ringGeometryLarge.dispose();
      ringGeometrySmall.dispose();
      ringMaterial.dispose();
      ringSmallMaterial.dispose();
      renderer.dispose();
    });
  }
</script>

<style lang="scss">
  .three-stage {
    position: absolute;
    z-index: 3;
    inset: 0;
    overflow: hidden;
    pointer-events: none;

    :global(.three-stage__canvas) {
      display: block;
      width: 100%;
      height: 100%;
      mix-blend-mode: multiply;
    }
  }
</style>

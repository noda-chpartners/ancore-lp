---
import { Icon } from 'astro-icon/components';

interface Props {
  content: {
    eyebrow: string;
    titleLines: readonly string[];
    subtitleLines: readonly string[];
    phone: {
      label: string;
      display: string;
      href: string;
      hours: string;
    };
    instagram: {
      label: string;
      href: string;
    };
  };
}

const { content } = Astro.props;
---

<section class="entry section" id="entry">
  <div class="entry__beam entry__beam--left"></div>
  <div class="entry__beam entry__beam--right"></div>
  <div class="entry__confetti" aria-hidden="true">
    <span class="entry__piece entry__piece--1"></span>
    <span class="entry__piece entry__piece--2"></span>
    <span class="entry__piece entry__piece--3"></span>
    <span class="entry__piece entry__piece--4"></span>
    <span class="entry__piece entry__piece--5"></span>
    <span class="entry__piece entry__piece--6"></span>
  </div>

  <div class="entry__inner container js-reveal">
    <p class="entry__eyebrow">{content.eyebrow}</p>
    <h2 class="entry__title">
      {
        content.titleLines.map((line) => (
          <span class="entry__title-line">{line}</span>
        ))
      }
    </h2>
    <p class="entry__description">
      {
        content.subtitleLines.map((line) => (
          <span class="entry__description-line">{line}</span>
        ))
      }
    </p>

    <div class="entry__actions">
      <a class="entry__phone" href={content.phone.href}>
        <span class="entry__action-label">{content.phone.label}</span>
        <span class="entry__phone-number">{content.phone.display}</span>
        <span class="entry__hours">{content.phone.hours}</span>
      </a>
      <a
        class="entry__instagram"
        href={content.instagram.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon class="entry__instagram-icon" name="simple-icons:instagram" />
        <span class="entry__instagram-label">{content.instagram.label}</span>
        <span class="entry__instagram-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .entry {
    display: grid;
    min-height: min(56rem, 90vh);
    place-items: center;
    overflow: hidden;
    color: var(--color-ink);
    background:
      radial-gradient(circle at 18% 22%, rgba(213, 170, 79, 0.2), transparent 30%),
      radial-gradient(circle at 82% 74%, rgba(142, 216, 230, 0.3), transparent 34%),
      linear-gradient(145deg, #ffffff 0%, var(--color-ivory) 54%, var(--color-pearl) 100%);

    &__beam {
      position: absolute;
      top: -20%;
      width: 46%;
      height: 130%;
      opacity: 0.42;
      background: linear-gradient(180deg, rgba(213, 170, 79, 0.2), transparent 68%);
      filter: blur(2px);
      clip-path: polygon(46% 0, 54% 0, 100% 100%, 0 100%);
      pointer-events: none;

      &--left {
        left: -5%;
        transform: rotate(-12deg);
      }

      &--right {
        right: -5%;
        background: linear-gradient(180deg, rgba(142, 216, 230, 0.28), transparent 68%);
        transform: rotate(12deg);
      }
    }

    &__inner {
      position: relative;
      z-index: 2;
      display: grid;
      justify-items: center;
      text-align: center;
    }

    &__eyebrow {
      font-family: var(--font-display);
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.32em;
    }

    &__title {
      margin-top: 1.25rem;
      font-family: var(--font-display);
      font-size: clamp(2.15rem, 5.8vw, 5.1rem);
      font-weight: 900;
      letter-spacing: -0.085em;
      line-height: 0.95;
    }

    &__title-line {
      display: block;
      white-space: nowrap;
    }

    &__description {
      max-width: 43rem;
      margin-top: 2rem;
      font-size: clamp(0.88rem, 1.3vw, 1.05rem);
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 2;
    }

    &__description-line {
      display: block;
    }

    &__actions {
      display: grid;
      grid-template-columns: minmax(20rem, 1.1fr) minmax(16rem, 0.9fr);
      gap: 0.9rem;
      width: min(100%, 48rem);
      margin-top: 3rem;
    }

    &__phone,
    &__instagram {
      min-height: 9rem;
      border: 1px solid rgba(63, 159, 179, 0.24);
      border-radius: 0.35rem;
      transition:
        transform 0.3s ease,
        background-color 0.3s ease,
        color 0.3s ease;

      &:hover {
        transform: translateY(-0.35rem);
      }
    }

    &__phone {
      display: grid;
      align-content: center;
      justify-items: center;
      padding: 1.2rem;
      color: var(--color-ink);
      background: rgba(255, 255, 255, 0.9);
      box-shadow: 0 18px 45px rgba(213, 170, 79, 0.12);

      &:hover {
        background: var(--color-cream);
      }
    }

    &__action-label,
    &__hours {
      color: rgba(32, 50, 56, 0.62);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.12em;
    }

    &__phone-number {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 4vw, 2.7rem);
      font-weight: 900;
      letter-spacing: -0.035em;
      line-height: 1.2;
    }

    &__instagram {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      padding: 1.2rem 1.5rem;
      background: rgba(238, 249, 250, 0.88);

      &:hover {
        background: var(--color-ivory);
      }
    }

    &__instagram-icon {
      width: 1.65rem;
      height: 1.65rem;
    }

    &__instagram-label {
      font-size: 0.8rem;
      font-weight: 900;
      text-align: left;
    }

    &__instagram-arrow {
      font-size: 1.4rem;
    }

    &__piece {
      position: absolute;
      z-index: 1;
      width: 0.55rem;
      height: 1.3rem;
      background: var(--color-ivory);
      transform: rotate(24deg);

      &--1 {
        top: 16%;
        left: 10%;
      }

      &--2 {
        top: 24%;
        right: 14%;
        background: var(--color-gold);
        transform: rotate(-35deg);
      }

      &--3 {
        bottom: 20%;
        left: 18%;
        width: 0.8rem;
        background: var(--color-aqua);
        transform: rotate(66deg);
      }

      &--4 {
        right: 8%;
        bottom: 15%;
        background: var(--color-gold);
        transform: rotate(16deg);
      }

      &--5 {
        top: 12%;
        left: 42%;
        width: 0.7rem;
        background: var(--color-aqua);
        transform: rotate(-58deg);
      }

      &--6 {
        right: 36%;
        bottom: 9%;
        transform: rotate(48deg);
      }
    }
  }

  @media (max-width: 767px) {
    .entry {
      min-height: 48rem;

      &__title {
        font-size: clamp(2rem, 9.2vw, 3.6rem);
      }

      &__title-line {
        white-space: normal;
      }

      &__description {
        max-width: 22rem;
      }

      &__actions {
        grid-template-columns: 1fr;
      }

      &__phone,
      &__instagram {
        min-height: 7.5rem;
      }
    }
  }
</style>

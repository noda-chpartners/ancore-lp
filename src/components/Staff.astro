---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  content: {
    eyebrow: string;
    title: string;
    message: {
      label: string;
      paragraphs: readonly string[];
      signOff: {
        title: string;
        name: string;
      };
    };
    members: readonly {
      name: string;
      role?: string;
      image: ImageMetadata;
      imageAlt: string;
    }[];
    gallery: readonly ImageMetadata[];
  };
}

const { content } = Astro.props;
---

<section class="staff section" id="staff">
  <div class="staff__light staff__light--gold" aria-hidden="true"></div>
  <div class="staff__light staff__light--aqua" aria-hidden="true"></div>

  <div class="staff__inner container">
    <div class="staff__heading section-heading js-reveal">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 class="staff__section-title section-title">
        <span class="title-line">{content.title}</span>
      </h2>
    </div>

    <article class="staff__message js-reveal">
      <p class="staff__message-label">{content.message.label}</p>
      <div class="staff__message-body">
        {
          content.message.paragraphs.map((paragraph) => (
            <p class="staff__message-paragraph">{paragraph}</p>
          ))
        }
      </div>
      <p class="staff__message-signoff">
        <span class="staff__message-signoff-title">{content.message.signOff.title}</span>
        <span class="staff__message-signoff-name">{content.message.signOff.name}</span>
      </p>
    </article>

    <div class="staff__members">
      {
        content.members.map((member, index) => (
          <article
            class:list={[
              'staff__card',
              'js-reveal',
              { 'staff__card--representative': index === 0 },
            ]}
          >
            <div class="staff__portrait-wrap">
              <Image
                class="staff__portrait"
                src={member.image}
                alt={member.imageAlt}
                loading="lazy"
                quality={88}
                widths={[420, 640, 860]}
                sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
              />
              <span class="staff__card-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="staff__profile">
              {member.role && <p class="staff__role">{member.role}</p>}
              <h3 class="staff__name">{member.name}</h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="staff__gallery" data-staff-gallery>
    <div class="staff__gallery-track" data-staff-gallery-track>
      {
        content.gallery.map((image, index) => (
          <figure class="staff__gallery-item">
            <Image
              class="staff__gallery-image"
              src={image}
              alt={`Ancoreの日常 ${String(index + 1).padStart(2, '0')}`}
              loading="eager"
              quality={78}
              widths={[360, 560, 720]}
              sizes="(max-width: 767px) 72vw, 22vw"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .staff {
    padding-bottom: 0;
    color: var(--color-ink);
    background:
      radial-gradient(circle at 8% 16%, rgba(213, 170, 79, 0.16), transparent 26%),
      radial-gradient(circle at 92% 42%, rgba(142, 216, 230, 0.24), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, var(--color-ivory) 62%, var(--color-pearl) 100%);

    &__light {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;

      &--gold {
        top: 10rem;
        left: -8rem;
        width: 22rem;
        height: 22rem;
        background: rgba(213, 170, 79, 0.13);
      }

      &--aqua {
        top: 35%;
        right: -10rem;
        width: 28rem;
        height: 28rem;
        background: rgba(142, 216, 230, 0.18);
      }
    }

    &__inner {
      position: relative;
      z-index: 1;
      padding-bottom: clamp(2.5rem, 5vw, 4rem);
    }

    &__heading {
      :global(.eyebrow) {
        color: var(--color-aqua-deep);
      }
    }

    &__section-title {
      color: var(--color-ink);
      font-size: clamp(2.3rem, 5.6vw, 5.1rem);
    }

    &__message {
      max-width: 46rem;
      margin: 0 0 clamp(4rem, 8vw, 6.5rem);
    }

    &__message-label {
      color: var(--color-aqua-deep);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.22em;
    }

    &__message-body {
      display: grid;
      gap: 1.35rem;
      margin-top: 1.5rem;
    }

    &__message-paragraph {
      color: rgba(7, 10, 14, 0.78);
      font-size: clamp(0.9rem, 1.25vw, 1.05rem);
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 2.15;
      white-space: pre-line;
    }

    &__message-signoff {
      display: grid;
      justify-items: end;
      gap: 0.35rem;
      margin-top: 2.25rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(7, 10, 14, 0.12);
    }

    &__message-signoff-title {
      color: rgba(7, 10, 14, 0.58);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    &__message-signoff-name {
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 2vw, 1.5rem);
      font-weight: 900;
      letter-spacing: 0.08em;
    }

    &__members {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: clamp(1rem, 2.4vw, 2rem);
    }

    &__card {
      position: relative;
      min-width: 0;

      &:nth-child(2) {
        margin-top: clamp(2rem, 5vw, 5rem);
      }

      &:nth-child(3) {
        margin-top: clamp(4rem, 9vw, 9rem);
      }

      &--representative {
        .staff__portrait-wrap {
          border-color: rgba(213, 170, 79, 0.5);
          box-shadow: 0 24px 70px rgba(213, 170, 79, 0.15);
        }

        .staff__card-number {
          background: var(--gradient-brand);
        }
      }
    }

    &__portrait-wrap {
      position: relative;
      overflow: hidden;
      aspect-ratio: 3 / 4;
      border: 1px solid rgba(63, 159, 179, 0.22);
      border-radius: 12rem 12rem 1.25rem 1.25rem;
      background: var(--color-cream);
      box-shadow: 0 24px 70px rgba(63, 159, 179, 0.11);
    }

    &__portrait {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 28%;
      transition:
        filter 0.55s ease,
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    &__card:hover &__portrait {
      filter: saturate(1.06);
      transform: scale(1.02);
    }

    &__card-number {
      position: absolute;
      right: 1rem;
      bottom: 1rem;
      display: grid;
      width: 3rem;
      height: 3rem;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.68);
      border-radius: 50%;
      color: var(--color-ink);
      background: rgba(238, 249, 250, 0.9);
      font-family: var(--font-display);
      font-size: 0.7rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      backdrop-filter: blur(10px);
    }

    &__profile {
      position: relative;
      display: grid;
      gap: 0.45rem;
      padding: 1.4rem 0.35rem 0;

      &::before {
        position: absolute;
        top: 0;
        left: 0.35rem;
        width: 3rem;
        height: 1px;
        background: linear-gradient(90deg, var(--color-gold), var(--color-aqua-deep));
        content: "";
      }
    }

    &__role {
      color: var(--color-aqua-deep);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.16em;
    }

    &__name {
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 2vw, 1.65rem);
      font-weight: 900;
      letter-spacing: 0.04em;
      line-height: 1.3;
    }

    &__gallery {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      box-sizing: border-box;
      width: 100%;
      height: 100vh;
      height: 100svh;
      margin: 0;
      overflow: hidden;
      padding: 5.75rem 0 0;
      background: var(--color-pearl);
    }

    &__gallery-track {
      display: flex;
      align-items: center;
      width: max-content;
      gap: 1rem;
      padding-inline: max(1.25rem, calc((100vw - var(--content-width)) / 2));
      will-change: transform;
    }

    &__gallery-item {
      width: clamp(14rem, 22vw, 20rem);
      flex: 0 0 auto;
      overflow: hidden;
      aspect-ratio: 3 / 2;
      margin: 0;
      border-radius: 0.7rem;
      background: var(--color-cream);
    }

    &__gallery-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    &__gallery-item:hover &__gallery-image {
      transform: scale(1.02);
    }
  }

  @media (max-width: 900px) {
    .staff {
      &__members {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      &__card:nth-child(2) {
        margin-top: 3rem;
      }

      &__card:nth-child(3) {
        grid-column: 1 / -1;
        width: min(100%, calc(50% - 0.5rem));
        margin: 1rem auto 0;
      }
    }
  }

  @media (max-width: 640px) {
    .staff {
      &__section-title {
        font-size: clamp(1.9rem, 9vw, 2.85rem);
      }

      &__message {
        margin-bottom: 3.25rem;
      }

      &__members {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      &__card:nth-child(2),
      &__card:nth-child(3) {
        grid-column: auto;
        width: 100%;
        margin-top: 0;
      }

      &__portrait-wrap {
        width: min(100%, 26rem);
        margin-inline: auto;
      }

      &__profile {
        width: min(100%, 26rem);
        margin-inline: auto;
      }

      &__gallery {
        padding-top: 5.15rem;
      }

      &__gallery-item {
        width: min(68vw, 16rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .staff {
      &__portrait,
      &__gallery-image {
        transition: none;
      }

      &__gallery {
        height: auto;
        min-height: 0;
        padding: 1.25rem;
        overflow-x: auto;
        scrollbar-width: thin;
      }

      &__gallery-track {
        will-change: auto;
      }
    }
  }
</style>
